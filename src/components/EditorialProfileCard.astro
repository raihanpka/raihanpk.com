---
import {
  PiEnvelope,
  PiGithubLogo,
  PiGlobe,
  PiInstagramLogo,
  PiLinkedinLogo,
  PiMapPin,
  PiBriefcase,
} from 'react-icons/pi'
interface Props {
  id: string
  name: string
  avatar?: string
  bio?: string
  role?: string
  location?: string
  pronouns?: string
  github?: string
  linkedin?: string
  instagram?: string
  website?: string
  mail?: string
  linkDisabled?: boolean
}

const {
  id,
  name,
  avatar,
  bio,
  role,
  location,
  pronouns,
  github,
  linkedin,
  instagram,
  website,
  mail,
  linkDisabled = false,
} = Astro.props

const socialLinks = [
  website && { href: website, label: 'Website', icon: PiGlobe },
  github && { href: github, label: 'GitHub', icon: PiGithubLogo },
  linkedin && { href: linkedin, label: 'LinkedIn', icon: PiLinkedinLogo },
  instagram && { href: instagram, label: 'Instagram', icon: PiInstagramLogo },
  mail && { href: `mailto:${mail}`, label: 'Email', icon: PiEnvelope },
].filter(Boolean) as { href: string; label: string; icon: any }[]
---

<div class="relative overflow-hidden rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-5 sm:p-6 shadow-sm transition-all duration-300 hover:border-foreground/30">
  {/* Top Specular Edge */}
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-foreground/20 to-transparent pointer-events-none" />

  <div class="flex flex-col md:flex-row md:items-start justify-between gap-5">
    {/* Identity Left Column */}
    <div class="flex items-start gap-4 sm:gap-5 flex-1 min-w-0">
      <div class="relative shrink-0">
        {linkDisabled ? (
          <img
            src={avatar || '/static/notion-avatar.png'}
            alt={`Profile photo of ${name}`}
            width="96"
            height="96"
            loading="eager"
            decoding="async"
            class="size-20 sm:size-24 rounded-xl border border-border/80 grayscale contrast-125 object-cover bg-secondary/40 shadow-sm"
          />
        ) : (
          <a href={`/authors/${id}`} class="block focus:outline-none focus:ring-2 focus:ring-primary rounded-xl">
            <img
              src={avatar || '/static/notion-avatar.png'}
              alt={`Profile photo of ${name}`}
              width="96"
              height="96"
              loading="eager"
              decoding="async"
              class="size-20 sm:size-24 rounded-xl border border-border/80 grayscale contrast-125 hover:grayscale-0 transition-all duration-300 object-cover bg-secondary/40 cursor-pointer shadow-sm"
            />
          </a>
        )}
      </div>

      <div class="flex flex-col gap-y-1.5 flex-1 min-w-0">
        <div class="flex flex-wrap items-baseline gap-x-2.5">
          <h1 class="text-xl sm:text-2xl font-bold font-mono text-foreground tracking-tight">{name}</h1>
          {pronouns && (
            <span class="text-xs font-mono text-muted-foreground border border-border/60 px-1.5 py-0.5 rounded">
              {pronouns}
            </span>
          )}
        </div>

        {(role || location) && (
          <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1 text-xs sm:text-sm font-mono text-muted-foreground">
            {role && (
              <span class="flex items-center gap-1.5">
                <PiBriefcase className="size-3.5 sm:size-4 shrink-0" />
                {role}
              </span>
            )}
            {location && (
              <span class="flex items-center gap-1.5">
                <PiMapPin className="size-3.5 sm:size-4 shrink-0" />
                {location}
              </span>
            )}
          </div>
        )}

        {bio && (
          <p class="text-sm sm:text-base text-foreground/80 font-sans leading-relaxed mt-1">
            "{bio}"
          </p>
        )}
      </div>
    </div>

    {/* Social Links Pill Bar */}
    <div class="flex flex-wrap items-center gap-2 self-start md:self-auto shrink-0 pt-1">
      {socialLinks.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex size-9 items-center justify-center rounded-lg border border-border bg-background/80 text-foreground transition-all duration-200 hover:bg-secondary hover:scale-105 active:scale-95 shadow-sm"
          aria-label={item.label}
          title={item.label}
        >
          <item.icon className="size-4 text-foreground" />
        </a>
      ))}
    </div>
  </div>
</div>
