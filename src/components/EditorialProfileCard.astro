---
import {
  PiEnvelope,
  PiGithubLogo,
  PiGlobe,
  PiInstagramLogo,
  PiLinkedinLogo,
  PiMapPin,
  PiBriefcase,
} from 'react-icons/pi'
import AvatarComponent from '@/components/ui/avatar'

interface Props {
  id: string
  name: string
  avatar?: string
  bio?: string
  pronouns?: string
  github?: string
  linkedin?: string
  instagram?: string
  website?: string
  mail?: string
  linkDisabled?: boolean
}

const {
  id,
  name,
  avatar,
  bio,
  pronouns,
  github,
  linkedin,
  instagram,
  website,
  mail,
  linkDisabled = false,
} = Astro.props

const socialLinks = [
  website && { href: website, label: 'Website', icon: PiGlobe },
  github && { href: github, label: 'GitHub', icon: PiGithubLogo },
  linkedin && { href: linkedin, label: 'LinkedIn', icon: PiLinkedinLogo },
  instagram && { href: instagram, label: 'Instagram', icon: PiInstagramLogo },
  mail && { href: `mailto:${mail}`, label: 'Email', icon: PiEnvelope },
].filter(Boolean) as { href: string; label: string; icon: any }[]
---

<div class="relative overflow-hidden rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-5 sm:p-7 shadow-sm transition-all duration-300 hover:border-foreground/30">
  {/* Blueprint technical crosshairs */}
  <span class="absolute top-2 left-2 text-xs font-mono text-muted-foreground/40 select-none">+</span>
  <span class="absolute top-2 right-2 text-xs font-mono text-muted-foreground/40 select-none">+</span>
  <span class="absolute bottom-2 left-2 text-xs font-mono text-muted-foreground/40 select-none">+</span>
  <span class="absolute bottom-2 right-2 text-xs font-mono text-muted-foreground/40 select-none">+</span>

  {/* Top Specular Edge */}
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-foreground/20 to-transparent pointer-events-none" />

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    {/* Identity Left Column */}
    <div class="flex items-center gap-4 sm:gap-5">
      <div class="relative group">
        {linkDisabled ? (
          <AvatarComponent
            src={avatar}
            alt={`Profile avatar of ${name}`}
            fallback={name[0]}
            className="size-20 sm:size-24 rounded-xl border border-border/60 grayscale contrast-125 object-cover"
          />
        ) : (
          <a href={`/authors/${id}`} class="block focus:outline-none focus:ring-2 focus:ring-primary rounded-xl">
            <AvatarComponent
              src={avatar}
              alt={`Profile avatar of ${name}`}
              fallback={name[0]}
              className="size-20 sm:size-24 rounded-xl border border-border/60 grayscale contrast-125 hover:grayscale-0 transition-all duration-300 object-cover cursor-pointer"
            />
          </a>
        )}
        <div class="absolute -bottom-1 -right-1 size-4 rounded-full bg-emerald-500 border-2 border-background" title="Active & Available" />
      </div>

      <div class="flex flex-col gap-y-1">
        <div class="flex flex-wrap items-baseline gap-x-2.5">
          <h1 class="text-xl sm:text-2xl font-bold font-mono text-foreground tracking-tight">{name}</h1>
          {pronouns && (
            <span class="text-xs font-mono text-muted-foreground border border-border/60 px-1.5 py-0.5 rounded">
              {pronouns}
            </span>
          )}
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-muted-foreground mt-1">
          <span class="flex items-center gap-1">
            <PiBriefcase className="size-3.5" />
            SWE & AI Systems
          </span>
          <span class="flex items-center gap-1">
            <PiMapPin className="size-3.5" />
            Bogor / Jakarta, ID
          </span>
        </div>
      </div>
    </div>

    {/* Social Links Pill Bar */}
    <div class="flex flex-wrap items-center gap-2">
      {socialLinks.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex size-9 items-center justify-center rounded-lg border border-border bg-background/80 text-foreground transition-all duration-200 hover:bg-secondary hover:scale-105 active:scale-95 shadow-sm"
          aria-label={item.label}
          title={item.label}
        >
          <item.icon className="size-4 text-foreground" />
        </a>
      ))}
    </div>
  </div>

  {bio && (
    <p class="mt-4 pt-4 border-t border-border/50 text-sm leading-relaxed text-muted-foreground font-sans">
      {bio}
    </p>
  )}
</div>
