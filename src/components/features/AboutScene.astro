---
/**
 * About scene: a quiet monochrome landscape with the logo character drawn faintly.
 * On hover, focus or tap the character fills in and speech bubbles slide in.
 */
import { bayer4 } from '@/lib/bayer'

interface Props {
  label: string
  nickname: string
  bubbles: string[]
  class?: string
}

const { label, nickname, bubbles, class: className } = Astro.props
// Ordered-dither tiles (4x4 Bayer cells, 2 units each) at three densities for the hills.
const CELL = 2
const tile = (density: number) => {
  const rects: { x: number; y: number }[] = []
  for (let y = 0; y < 4; y++) for (let x = 0; x < 4; x++) if (bayer4(x, y) < density) rects.push({ x: x * CELL, y: y * CELL })
  return rects
}
const patterns = [
  { id: 'dither-far', rects: tile(0.05) },
  { id: 'dither-mid', rects: tile(0.09) },
  { id: 'dither-near', rects: tile(0.15) },
]
---

<div
  class:list={['scene about-card isolate relative min-h-60 overflow-hidden', className]}
  tabindex="0"
  role="group"
  aria-label={`${label} ${nickname}`}
>
  <svg
    class="absolute inset-0 size-full text-foreground/45"
    viewBox="0 0 400 300"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
    shape-rendering="crispEdges"
  >
    <defs>
      {patterns.map((p) => (
        <pattern id={p.id} width={CELL * 4} height={CELL * 4} patternUnits="userSpaceOnUse">
          {p.rects.map((r) => <rect x={r.x} y={r.y} width={CELL} height={CELL} fill="currentColor"></rect>)}
        </pattern>
      ))}
    </defs>
    <g transform="translate(0 55)">
    <path d="M0 170 C60 130 110 150 170 125 S280 120 340 150 S390 140 400 135 V300 H0Z" fill="url(#dither-far)"></path>
    <path d="M0 210 C70 175 140 200 210 170 S330 175 400 190 V300 H0Z" fill="url(#dither-mid)"></path>
    <path d="M0 245 C80 215 150 240 230 218 S350 225 400 235 V300 H0Z" fill="url(#dither-near)"></path>
    </g>
  </svg>

  <div class="scene-person absolute -bottom-6 left-6 flex w-32 flex-col-reverse items-center sm:w-36" aria-hidden="true">
    <svg class="scene-body -translate-y-3 h-20 w-[78%] text-foreground" viewBox="0 0 100 80" preserveAspectRatio="none" focusable="false">
      <path d="M2 80 V40 Q2 8 32 8 H68 Q98 8 98 40 V80 Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
    </svg>
    <div class="relative aspect-square w-full">
      <span class="scene-ring absolute inset-0 rounded-full"></span>
      <img
        src="/static/profile/avatar-ink.png"
        alt=""
        width="512"
        height="573"
        loading="lazy"
        decoding="async"
        class="scene-ink absolute left-1/2 top-1/2 h-[66%] w-auto -translate-x-1/2 -translate-y-1/2 select-none"
        draggable="false"
      />
    </div>
  </div>

  <div class="scene-idle absolute right-5 top-5 flex max-w-[45%] flex-col items-end gap-2 text-right">
    <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">{label}</p>
    <p class="font-title text-display text-foreground">{nickname}</p>
  </div>

  <div class="absolute inset-y-4 right-4 left-[44%] flex flex-col justify-center gap-2" aria-hidden="false">
    {bubbles.map((text, i) => (
      <p class="scene-bubble rounded-lg border border-border bg-background/90 p-3 text-sm text-foreground shadow-2 backdrop-blur-sm" style={`--i:${i}`}>
        {text}
      </p>
    ))}
  </div>
</div>

<style>
  /* Fixed light palette: the scene looks the same in light and dark mode. */
  .scene {
    --background: 0 0% 100%;
    --foreground: 0 0% 3.9%;
    --muted-foreground: 0 0% 40%;
    --border: 0 0% 82%;
    background: hsl(0 0% 94%);
    color-scheme: light;
  }
  /* Idle: only an outlined head circle and body. Hover: head, face and body fill in and the figure rises. */
  .scene-person { transition: transform 0.5s cubic-bezier(0.34, 1.3, 0.64, 1); }
  .scene-ring { border: 1.5px solid hsl(var(--foreground) / 0.55); }
  .scene-ink { opacity: 0; transition: opacity 0.4s ease; }
  .scene-ring { transition: opacity 0.4s ease; }
  .scene-body path { fill-opacity: 0; stroke-opacity: 0.55; transition: fill-opacity 0.4s ease, stroke-opacity 0.4s ease; }
  .scene-idle { transition: opacity 0.3s ease; }
  .scene-bubble {
    position: relative;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition: opacity 0.3s ease, transform 0.3s ease;
    transition-delay: 0s;
  }
  /* Little tail pointing at the character. */
  .scene-bubble::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 14px;
    width: 8px;
    height: 8px;
    background: hsl(var(--background));
    border-left: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
    transform: rotate(45deg);
  }
  .scene:hover .scene-person,
  .scene:focus-within .scene-person { transform: translateY(-8px); }
  .scene:hover .scene-ink,
  .scene:focus-within .scene-ink { opacity: 1; }
  .scene:hover .scene-ring,
  .scene:focus-within .scene-ring { opacity: 0; }
  .scene:hover .scene-body path,
  .scene:focus-within .scene-body path { fill-opacity: 0.85; stroke-opacity: 1; }
  .scene:hover .scene-idle,
  .scene:focus-within .scene-idle { opacity: 0; }
  .scene:hover .scene-bubble,
  .scene:focus-within .scene-bubble {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 90ms + 120ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-person, .scene-ink, .scene-ring, .scene-body path, .scene-idle, .scene-bubble { transition: none; }
  }
</style>
