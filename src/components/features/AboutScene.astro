---
/**
 * About scene: a quiet monochrome landscape with the logo character drawn faintly.
 * On hover, focus or tap the character fills in and speech bubbles slide in.
 */
interface Props {
  label: string
  nickname: string
  bubbles: string[]
  class?: string
}

const { label, nickname, bubbles, class: className } = Astro.props
// Pine positions on the near hill: x, y, scale.
const pines = [
  [318, 232, 1],
  [350, 238, 1.3],
  [382, 230, 0.9],
]
---

<div
  class:list={['scene about-card isolate relative min-h-60 overflow-hidden', className]}
  tabindex="0"
  role="group"
  aria-label={`${label} ${nickname}`}
>
  <svg
    class="absolute inset-0 size-full text-foreground"
    viewBox="0 0 400 300"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="60" cy="58" r="20" fill="none" stroke="currentColor" stroke-opacity="0.18" stroke-width="1.5"></circle>
    <path d="M0 170 C60 130 110 150 170 125 S280 120 340 150 S390 140 400 135 V300 H0Z" fill="currentColor" fill-opacity="0.06"></path>
    <path d="M0 210 C70 175 140 200 210 170 S330 175 400 190 V300 H0Z" fill="currentColor" fill-opacity="0.1"></path>
    <path d="M0 245 C80 215 150 240 230 218 S350 225 400 235 V300 H0Z" fill="currentColor" fill-opacity="0.16"></path>
    {pines.map(([x, y, k]) => (
      <path
        transform={`translate(${x} ${y}) scale(${k})`}
        d="M0 -30 L9 -10 H4 L12 8 H3 L14 28 H-14 L-3 8 H-12 L-4 -10 H-9Z"
        fill="currentColor"
        fill-opacity="0.3"
      ></path>
    ))}
  </svg>

  <img
    src="/static/profile/avatar.png"
    alt=""
    width="176"
    height="176"
    loading="lazy"
    decoding="async"
    class="scene-char absolute -bottom-5 left-3 size-40 select-none sm:size-44 dark:invert"
    draggable="false"
  />

  <div class="scene-idle absolute right-5 top-5 flex max-w-[45%] flex-col items-end gap-2 text-right">
    <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">{label}</p>
    <p class="font-title text-display text-foreground">{nickname}</p>
  </div>

  <div class="absolute inset-y-4 right-4 left-[44%] flex flex-col justify-center gap-2" aria-hidden="false">
    {bubbles.map((text, i) => (
      <p class="scene-bubble rounded-lg border border-border bg-background/90 p-3 text-sm text-foreground shadow-2 backdrop-blur-sm" style={`--i:${i}`}>
        {text}
      </p>
    ))}
  </div>
</div>

<style>
  .scene-char {
    opacity: 0.2;
    transform: translateY(14px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .scene-idle { transition: opacity 0.3s ease; }
  .scene-bubble {
    position: relative;
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition: opacity 0.3s ease, transform 0.3s ease;
    transition-delay: 0s;
  }
  /* Little tail pointing at the character. */
  .scene-bubble::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 14px;
    width: 8px;
    height: 8px;
    background: hsl(var(--background));
    border-left: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
    transform: rotate(45deg);
  }
  .scene:hover .scene-char,
  .scene:focus-within .scene-char {
    opacity: 1;
    transform: translateY(0) rotate(-2deg);
  }
  .scene:hover .scene-idle,
  .scene:focus-within .scene-idle { opacity: 0; }
  .scene:hover .scene-bubble,
  .scene:focus-within .scene-bubble {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 90ms + 120ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .scene-char, .scene-idle, .scene-bubble { transition: none; }
  }
</style>
