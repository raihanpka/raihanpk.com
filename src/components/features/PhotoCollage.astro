---
/**
 * Aesthetic Photo Collage component
 * Inspired by creative studio & non-tech minimalist blogs.
 * Asymmetric pinboard gallery with slight tilts, 1px borders, and technical captions.
 * Ready to host user photos or animated GIFs seamlessly.
 */

interface PhotoItem {
  src: string
  caption: string
  aspect?: string
  tilt?: string
}

interface Props {
  photos?: PhotoItem[]
}

const defaultPhotos: PhotoItem[] = [
  {
    src: '/static/twitter-card.png',
    caption: 'FIG 01. / CORE DEV ENVIRONMENT & ARCHITECTURE',
    aspect: 'aspect-[4/3]',
    tilt: 'sm:-rotate-1',
  },
  {
    src: '/static/astro-cover.webp',
    caption: 'FIG 02. / PRODUCTION PLATFORM & HACKATHON SPRINTS',
    aspect: 'aspect-[16/10]',
    tilt: 'sm:rotate-1',
  },
  {
    src: '/static/lighthouse.webp',
    caption: 'FIG 03. / 100% AUDIT BENCHMARKS & CORE WEB VITALS',
    aspect: 'aspect-[16/9]',
    tilt: 'sm:-rotate-0.5',
  },
]

const { photos = defaultPhotos } = Astro.props
---

<section class="mt-8 pt-8 border-t border-border/60">
  <div class="flex items-baseline justify-between mb-6">
    <h3 class="text-sm font-mono uppercase tracking-widest text-muted-foreground">
      Visual Archives / Snapshots
    </h3>
    <span class="text-xs font-mono text-muted-foreground/60">
      FIG 01 - 03
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {photos.map((item) => (
      <figure class={`group relative flex flex-col overflow-hidden rounded-xl border border-border/80 bg-card/70 p-3 shadow-sm transition-all duration-500 hover:border-foreground/40 hover:-translate-y-1 hover:shadow-md ${item.tilt ?? ''}`}>
        {/* Photo Container */}
        <div class={`relative w-full ${item.aspect ?? 'aspect-[4/3]'} overflow-hidden rounded-lg bg-secondary/50 border border-border/40`}>
          <img
            src={item.src}
            alt={item.caption}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover grayscale contrast-110 transition-all duration-500 ease-out group-hover:grayscale-0 group-hover:scale-105"
          />
          {/* Subtle vignette overlay */}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60 group-hover:opacity-20 transition-opacity duration-300" />
        </div>

        {/* Monospaced Technical Caption */}
        <figcaption class="mt-3 flex items-center justify-between text-[10px] font-mono text-muted-foreground tracking-tight">
          <span class="truncate">{item.caption}</span>
          <span class="size-1 rounded-full bg-foreground/40 group-hover:bg-foreground transition-colors" />
        </figcaption>
      </figure>
    ))}
  </div>
</section>
