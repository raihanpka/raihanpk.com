---
/**
 * Core Memories: each photo is a postage stamp, perforated edge, a postmark over one corner, and a
 * caption under it. The stamps sit on a plain grid inside the content container and keep a fixed,
 * slight tilt so the sheet looks hand-placed. Nothing moves on hover or on its own.
 * Photos are plain <img> tags. Build-time image optimization fetched remote photos, which failed on CI runners.
 */

import memoriesData from '@/data/memories.json'

interface PhotoItem {
  src: string
  caption: string
}

interface Props {
  photos?: PhotoItem[]
}

const { photos = memoriesData } = Astro.props

// Degrees of tilt per stamp, by position. Fixed so the layout is the same on every render.
const TILT = [-1.2, 0.8, -0.6, 1.1, -0.9, 0.5]

// Perforated edge as a mask: the paper square with a notch (half circle) cut along every side.
// Built once at build time as an SVG data URI, so the holes scale with the stamp.
function perforationMask(): string {
  const S = 100
  const STEP = 5
  const R = 1.4
  const hole = (cx: number, cy: number) =>
    `M${cx - R} ${cy}a${R} ${R} 0 1 0 ${2 * R} 0a${R} ${R} 0 1 0 ${-2 * R} 0Z`
  let d = `M0 0H${S}V${S}H0Z`
  for (let p = STEP / 2; p < S; p += STEP) {
    d += hole(p, 0) + hole(p, S) + hole(0, p) + hole(S, p)
  }
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${S} ${S}" preserveAspectRatio="none"><path fill-rule="evenodd" d="${d}"/></svg>`
  return `url('data:image/svg+xml,${encodeURIComponent(svg)}')`
}
const PERFORATION = perforationMask()
---

<section class="mt-2 pt-4 border-t border-border/50">
  <div class="mb-6">
    <h2 class="font-title text-2xl max-sm:leading-tight sm:text-display-sm text-foreground">
      Core Memories
    </h2>
    <p class="text-sm text-muted-foreground mt-1">
      A few moments with the people I met along the way.
    </p>
  </div>

  <ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-x-6">
    {
      photos.map((item, i) => (
        <li>
          <figure class="memory-stamp relative flex flex-col" style={`--tilt:${TILT[i % TILT.length]}deg`}>
            <div class="stamp-paper bg-card p-2 sm:p-3" style={`--perforation:${PERFORATION}`}>
              <div class="aspect-square overflow-hidden bg-secondary/50">
                <img
                  src={item.src}
                  alt={item.caption}
                  width={600}
                  height={600}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-center"
                />
              </div>
            </div>
            {/* Postmark: a cancellation over the top corner. Outside the perforated paper, so the mask does not cut it. */}
            <svg
              viewBox="0 0 120 80"
              aria-hidden="true"
              class="pointer-events-none absolute -right-4 -top-5 w-20 text-foreground/30 sm:w-24"
            >
              <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M6 22 Q 16 14 26 22 T 46 22 T 66 22 T 86 22" />
                <path d="M6 34 Q 16 26 26 34 T 46 34 T 66 34 T 86 34" />
                <path d="M6 46 Q 16 38 26 46 T 46 46 T 66 46 T 86 46" />
                <circle cx="96" cy="40" r="22" />
              </g>
            </svg>
            <figcaption class="mt-3 text-xs sm:text-sm leading-relaxed text-muted-foreground">
              {item.caption}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .memory-stamp {
    transform: rotate(var(--tilt));
    /* on the figure, not the paper: the paper's mask would cut a shadow away. token-ok: drop-shadow filter, box-shadow tokens cannot follow a mask */
    filter: drop-shadow(0 1px 2px hsl(var(--foreground) / 0.12));
  }

  /* Perforated edge: small holes along all four sides, cut with a mask. The paper keeps its
     padding, so the holes only nick the edge and never reach the photo. */
  .stamp-paper {
    mask-image: var(--perforation);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
</style>
