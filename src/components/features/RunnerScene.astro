---
/**
 * The About card's scene: the runner along the bottom and the nickname top right. The two bubble lines are
 * pixel speech frames that open when the runner is tapped or hovered. Same card surface as the other About cards.
 */
import PekaRunner from '@/components/features/PekaRunner.tsx'

interface Props {
  label: string
  nickname: string
  bubbles: string[]
  class?: string
}

const { label, nickname, bubbles, class: className } = Astro.props
---

<section class:list={['about-card relative isolate min-h-60 overflow-hidden p-5 sm:p-6', className]}>
  <PekaRunner client:visible label={label} nickname={nickname} bubbles={bubbles} />
</section>


