---
/**
 * The About card's scene: the runner along the bottom and the nickname top right. The two bubble lines are
 * pixel speech frames that open when the runner is tapped or hovered. Same card surface as the other About cards.
 */
import PekaRunner from '@/components/features/PekaRunner.tsx'

interface Props {
  label: string
  nickname: string
  bubbles: string[]
  class?: string
}

const { label, nickname, bubbles, class: className } = Astro.props
---

<section class:list={['about-card relative isolate min-h-[30rem] overflow-hidden p-5 sm:p-6', className]}>
  <div class="flex flex-col items-end gap-1 text-right">
    <p class="text-sm text-muted-foreground">{label}</p>
    <p class="font-title text-4xl sm:text-display text-foreground">{nickname}</p>
  </div>
  <PekaRunner client:visible bubbles={bubbles} />
</section>


