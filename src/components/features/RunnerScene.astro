---
/**
 * The About card's scene: a pixel runner made from the profile drawing, with the label, the nickname and
 * the bubble lines as text above it. Same card surface as the other About cards.
 */
import PekaRunner from '@/components/features/PekaRunner.tsx'

interface Props {
  label: string
  nickname: string
  bubbles: string[]
  class?: string
}

const { label, nickname, bubbles, class: className } = Astro.props
---

<section class:list={['about-card relative isolate flex min-h-80 flex-col gap-3 overflow-hidden p-5 pb-32 sm:p-6 sm:pb-32', className]}>
  <div class="flex flex-col gap-1 text-right self-end max-w-[70%]">
    <p class="text-sm text-muted-foreground">{label}</p>
    <p class="font-title text-4xl sm:text-display text-foreground">{nickname}</p>
  </div>
  <div class="max-w-[70%] flex flex-col gap-1">
    {bubbles.map((text) => (
      <p class="text-sm text-muted-foreground">{text}</p>
    ))}
  </div>
  <PekaRunner client:visible />
</section>
