---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import FloatingChatButton from '@/components/chat/FloatingChatButton.tsx'
import MonochromeDitherCanvas from '@/components/ui/MonochromeDitherCanvas.tsx'
import { SITE } from '@/consts'
import SpeedInsights from '@vercel/speed-insights/astro'

type Props = {
  title: string
  description: string
  image?: string
  fullTitle?: string
}

const { title, description, image, fullTitle } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <Head
      title={fullTitle ?? `${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
    />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased relative">
    <MonochromeDitherCanvas client:idle />
    <div class="relative z-10 flex min-h-dvh flex-col">
      <Header />
      <main class="flex-1">
        <div class="py-section-sm">
          <slot />
        </div>
      </main>
      {Astro.url.pathname !== '/chat' && <FloatingChatButton client:idle />}
      <Footer />
    </div>
    <SpeedInsights />
  </body>
</html>
