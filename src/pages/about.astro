---
import { AuthorCardClient } from '@/components/AuthorCardClient'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { getImage } from 'astro:assets'

const authors = await getCollection('authors')

const optimizedAuthors = await Promise.all(
  authors.map(async (author) => {
    let optimizedAvatar = author.data.avatar
    if (author.data.avatar && !author.data.avatar.startsWith('http')) {
      try {
        const img = await getImage({
          src: author.data.avatar,
          width: 256,
          format: 'webp',
          inferSize: true,
        })
        optimizedAvatar = img.src
      } catch (e) {
        console.error(`Failed to optimize avatar for ${author.data.name}:`, e)
      }
    }
    return {
      ...author,
      optimizedAvatar,
    }
  })
)
---

<Layout title="About" description={SITE.DESCRIPTION}>
  <Container class="flex flex-col gap-y-6">
    <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

    {
      optimizedAuthors.length > 0 ? (
        <ul class="not-prose flex flex-col gap-4">
          {optimizedAuthors.map((author) => (
            <li>
              <AuthorCardClient
                client:load
                id={author.id}
                name={author.data.name}
                avatar={author.optimizedAvatar}
                bio={author.data.bio}
                pronouns={author.data.pronouns}
                github={author.data.github}
                linkedin={author.data.linkedin}
                instagram={author.data.instagram}
                website={author.data.website}
                mail={author.data.mail}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-center text-muted-foreground">No authors found.</p>
      )
    }

    <section>
      <div class="min-w-full">
        <div class="prose prose-neutral max-w-none mb-8 dark:prose-invert">
          <h2 class="mb-4 text-2xl font-semibold">Hello, I'm Raihan.</h2>
          <p class="mb-4">
            My name is Raihan Putra Kirana, but my friends often called me "Peka". 
            I am currently a third-year student majoring in Computer Science at 
            <Link
              href="https://ipb.ac.id"
              class="text-foreground"
              external
              underline>IPB University</Link>. 
            I'd say I'm a person who enjoys bridging the gap between robust software systems and real-world business impact.
          </p>
          <p>
            I treat software architecture with production-grade seriousness, even for small-scale projects or university assignments. 
            I focus on building AI-native applications with a strong obsession for modular design, clean codebases, and scalable systems. 
            This mindset of treating every project like production software has led me and my teams to multiple national hackathon podiums 
            and top finalist positions. I thrive in high-pressure environments where technical idealism meets rapid execution, 
            turning complex system challenges into functional, intelligent products.
          </p>
        </div>
      </div>
    </section>
  </Container>
</Layout>
