---
import BlogCard from '@/components/BlogCard.astro'
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import { ProjectsShowcase } from '@/components/features/ProjectsShowcase.tsx'
import SpotifyPresence from '@/components/features/SpotifyPresence.tsx'
import TechStackSlider from '@/components/features/TechStackSlider.tsx'
import WakatimeBox from '@/components/features/WakatimeBox.tsx'
import ResumeModal from '@/components/features/ResumeModal.tsx'
import { buttonVariants } from '@/components/ui/button'
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)

const rawProjects = (await getCollection('projects'))
  .sort((a, b) => {
    // date is 'Month Year' string e.g. 'May 2025' — parse to Date for comparison
    const toDate = (d?: string) => d ? new Date(d) : new Date(0)
    return toDate(b.data.date).valueOf() - toDate(a.data.date).valueOf()
  })
const projectsData = rawProjects.map((p) => ({
  name: p.data.name,
  description: p.data.description,
  tags: p.data.tags,
  type: p.data.type ?? [],
  asset: p.data.asset,
  fallback: p.data.fallback,
  link: p.data.link,
  github: p.data.github,
  date: p.data.date,
  techStack: p.data.techStack,
}))
---

<Layout title="Home" description={SITE.DESCRIPTION} fullTitle="Raihan Putra Kirana">
  <Container class="flex flex-col gap-y-6">
    <section>
      <Card>
        <CardHeader>
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <CardTitle className="text-3xl"><span class="font-mono">Raihan Putra Kirana</span></CardTitle>
              <CardDescription>/ˈraɪ.han.peˈka/ &bull; 
                <span class="font-bold font-mono">SWE & AI Enthusiast &bull; 3rd Year CS @ IPB</span>
              </CardDescription>
            </div>
            <div class="shrink-0">
              <ResumeModal client:idle />
            </div>
          </div>
        </CardHeader>
        <CardContent>
          <p class="mb-2 text-md text-foreground">
            From software solutions, automation, to cloud pipelines. I engineer end-to-end systems transforming my expertise into scalable applications, leading teams to deliver real product wins.
          </p>
        </CardContent>
      </Card>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div role="region" aria-label="Wakatime Section"
        class="lg:col-span-2 flex h-[190px] sm:h-[210px] w-full flex-col items-start whitespace-nowrap rounded-xl border border-border bg-card/60 backdrop-blur-sm shadow-sm p-3 text-xs leading-loose text-foreground transition-all duration-300 hover:border-foreground/30">
        <WakatimeBox omitLanguages={['Markdown', 'JSON']} client:visible />
      </div>

      <div role="region" aria-label="Spotify Section"
        class="lg:col-span-2 flex h-[190px] sm:h-[210px] w-full flex-col items-start whitespace-nowrap rounded-xl border border-border bg-card/60 backdrop-blur-sm shadow-sm p-3 text-xs leading-loose text-foreground transition-all duration-300 hover:border-foreground/30">
        <SpotifyPresence client:idle />
      </div>

      <div role="region" aria-label="Tech Stack"
        class="col-span-1 md:col-span-2 lg:col-span-4 h-[250px] sm:h-[280px] w-full flex flex-col items-start whitespace-nowrap rounded-xl border border-border bg-card/60 backdrop-blur-sm shadow-sm p-4 text-xs leading-loose text-foreground transition-all duration-300 hover:border-foreground/30">
        <TechStackSlider client:idle />
      </div>
    </section>

    <section class="flex flex-col gap-y-4">
      <ProjectsShowcase projects={projectsData} client:visible />
    </section>

    <section class="flex flex-col gap-y-4">
      <div class="flex items-center gap-4">
        <h2 class="shrink-0 text-2xl font-bold">Latest posts</h2>
        {/* <div className="h-px flex-1 bg-border" /> */}
      </div>
      <ul class="not-prose flex flex-col gap-y-4">
        {
          blog.map((post) => (
            <li>
              <BlogCard entry={post} />
            </li>
          ))
        }
      </ul>
      <div class="flex justify-center">
        <Link
          href="/blog"
          class={buttonVariants({ variant: 'ghost' }) + ' group'}
        >
          See all posts <span
            class="ml-1.5 transition-transform group-hover:translate-x-1"
            >&rarr;</span
          >
        </Link>
      </div>
    </section>
  </Container>
</Layout>
